# FOGGIE "NEW ICS" L3 baryons 

ProblemType                = 30      // cosmology simulation
TopGridRank                = 3
TopGridDimensions          = 512 512 512
TopGridGravityBoundary     = 0       // Periodic BC for gravity
LeftFaceBoundaryCondition  = 3 3 3   // same for fluid
RightFaceBoundaryCondition = 3 3 3
SelfGravity                = 1       // gravity on
PotentialIterations        = 4

#
#  problem parameters
#
CosmologySimulationOmegaBaryonNow        = 0.04576
CosmologySimulationOmegaCDMNow           = 0.24524
CosmologySimulationDensityName           = GridDensity
CosmologySimulationVelocity1Name         = GridVelocities_x
CosmologySimulationVelocity2Name         = GridVelocities_y
CosmologySimulationVelocity3Name         = GridVelocities_z
CosmologySimulationParticleVelocity1Name = ParticleVelocities_x
CosmologySimulationParticleVelocity2Name = ParticleVelocities_y
CosmologySimulationParticleVelocity3Name = ParticleVelocities_z
CosmologySimulationParticleDisplacement1Name = ParticleDisplacements_x
CosmologySimulationParticleDisplacement2Name = ParticleDisplacements_y
CosmologySimulationParticleDisplacement3Name = ParticleDisplacements_z
CosmologySimulationParticleTypeName     = RefinementMask
CosmologySimulationCalculatePositions    = 1
CosmologySimulationNumberOfInitialGrids  = 4

#
#  define cosmology parameters
#
ComovingCoordinates        = 1       // Expansion ON
CosmologyOmegaMatterNow    = 0.291
CosmologyOmegaDarkMatterNow = 0.24524
CosmologyOmegaLambdaNow    = 0.709
CosmologyHubbleConstantNow = 0.7
CosmologyComovingBoxSize   = 25.0    // in Mpc/h 
CosmologyMaxExpansionRate  = 0.015   // maximum allowed delta(a)/a
CosmologyInitialRedshift   = 99.0
CosmologyFinalRedshift 	   = 15   // first leg only; RunScript.sh
                                     // rewrites this to 0 and restarts once
                                     // shielded cooling is switched on
GravitationalConstant      = 1       // this must be true for cosmology


CosmologySimulationUseMetallicityField = 1 
StarFeedbackTrackMetalSources          = 1 
StarMakerStoreInitialMass              = 1 
ComputePotential =1 
WritePotential =1 

#
#  set I/O and stop/start parameters
#
DataDumpDir      = DD
DataDumpName     = DD
RedshiftDumpName = RD
RedshiftDumpDir  = RD

dtDataDump 	 = 1        // gas runs dump on a cadence for analysis, unlike DM
dtRestartDump    = 388800  // wallclock checkpoint before the PBS wall

OutputCoolingTime                        = 1
OutputTemperature                        = 1

NumberOfOutputsBeforeExit = 1

StopCycle        = 100000
StopCPUTime      = 3600000

#
#  set hydro parameters
#
HydroMethod                     = 0       // PPM
RiemannSolver                   = 4       // HLLC
Gamma                           = 1.6667
PPMDiffusionParameter           = 3       // diffusion off
ApplyBoundsToBaryonFields       = 1       // clamp baryon fields to the
                                          // density/energy floors rather than
                                          // letting a bad zone crash the run
DualEnergyFormalism             = 1       // use total & internal energy
InterpolationMethod             = 1       // SecondOrderA
ReconstructionMethod            = 1 // PPM
RiemannSolverFallback           = 1 // HLL if there's a dnu<=0
FluxCorrection                  = 1
ConservativeInterpolation       = 0
CourantSafetyNumber             = 0.4
ParticleCourantSafetyNumber     = 0.5


#
#  set grid refinement parameters
#
StaticHierarchy                = 0    // dynamic hierarchy
MaximumRefinementLevel         = 9
MaximumGravityRefinementLevel  = 9
MaximumParticleRefinementLevel = 9
RefineBy                       = 2    // refinement factor
CellFlaggingMethod             = 2 4 8 
MinimumEfficiency              = 0.4  // fraction efficiency
MinimumOverDensityForRefinement = 0.015625 0.015625 1. 1. 1. 1. 1

MinimumMassForRefinementLevelExponent = 0.0 0.0
MustRefineParticlesCreateParticles = 3
MustRefineParticlesRefineToLevel   = 3
NumberOfBufferZones                      = 2

RebuildHierarchyCycleSkip[0] = 2
RebuildHierarchyCycleSkip[1] = 2
RebuildHierarchyCycleSkip[2] = 2
RebuildHierarchyCycleSkip[3] = 2
RebuildHierarchyCycleSkip[4] = 2
RebuildHierarchyCycleSkip[5] = 2
RebuildHierarchyCycleSkip[6] = 2

CosmologyOutputRedshift[0]  = 99.0
CosmologyOutputRedshift[1]  = 50.0
CosmologyOutputRedshift[2]  = 10.0
CosmologyOutputRedshift[3]  = 9.0
CosmologyOutputRedshift[4] = 8.0
CosmologyOutputRedshift[5] = 7.0
CosmologyOutputRedshift[6] = 6.0
CosmologyOutputRedshift[7] = 5.0
CosmologyOutputRedshift[8] = 4.0
CosmologyOutputRedshift[9] = 3.0
CosmologyOutputRedshift[10] = 2.0
CosmologyOutputRedshift[11] = 1.0
CosmologyOutputRedshift[12] = 0.5
CosmologyOutputRedshift[13] = 0.2
CosmologyOutputRedshift[14] = 0.0


#
#  chemistry, cooling, radiation background
#
RadiativeCooling                         = 1
use_grackle                              = 1
MultiSpecies                             = 2
MultiMetals                              = 0
MetalCooling                             = 1
# Unshielded cooling for the first leg (z > 15).  RunScript.sh
# flips all three of these, together with CosmologyFinalRedshift, at the stop
# redshift.  Kept explicit rather than left to Enzo's defaults so that a restart
# file shows plainly which leg it belongs to.
H2FormationOnDust                        = 0
self_shielding_method                    = 0
H2_self_shielding                        = 0
UVbackground                             = 1
grackle_data_file                        = /u/jtumlins/grackle/grackle-3.3.1-dev/grackle_data_files/input/CloudyData_UVB=HM2012.h5
CMBTemperatureFloor                      = 1

#
# star formation and feedback parameters
#
StarParticleCreation                     = 2048
StarFormationOncePerRootGridTimeStep     = 1
StarParticleFeedback                     = 64
StarMakerOverDensityThreshold            = 1.0e+4
StarMakerMinimumMass                     = 10
StarMakerMinimumDynamicalTime            = 1e6
StarMakerMassEfficiency                  = 0.02
StarMassEjectionFraction                 = 0.25
StarMetalYield                           = 0.025
StarEnergyToThermalFeedback              = 1e-5
StarFeedbackDistRadius                   = 1
StarFeedbackDistCellStep                 = 3

H2StarMakerH2FractionMethod        = 1
H2StarMakerEfficiency              = 0.02
H2StarMakerNumberDensityThreshold  = 0
H2StarMakerMinimumH2FractionForStarFormation = 0
H2StarMakerStochastic              = 0
H2StarMakerUseSobolevColumn        = 1
H2StarMakerSigmaOverR              = 0.0333333
H2StarMakerAssumeColdWarmPressureBalance = 1
H2StarMakerH2DissociationFlux_MW   = 1
H2StarMakerH2FloorInColdGas        = 0
H2StarMakerColdGasTemperature      = 10000
H2StarMakerUseLocalDensityMax      = 1
H2StarMakerWriteStarLogFiles       = 1

#
# parallelism stuff
#

SubgridSizeAutoAdjust       = 1
OptimalSubgridsPerProcessor = 16

#
#
GreensFunctionMaxNumber = 30 
ParallelRootGridIO                       = 1
ParallelParticleIO                       = 1
PartitionNestedGrids                     = 1
UnigridTranspose     = 2

LoadBalancing          = 1
ResetLoadBalancing     = 1
LoadBalancingCycleSkip = 10
LoadBalancingMinLevel  = 0
LoadBalancingMaxLevel  = 50

#
#  nested grid geometry, written by MUSIC into parameter_file.txt
#

